{
  "name": "ziwei-paipan-jiepan",
  "version": "0.1.0",
  "description": "紫微斗数+八字排盘解盘工具（iztro + lunar-javascript + 智谱GLM-5.2）",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node main.js",
    "verify": "node verify.js",
    "build:web": "esbuild web/src/main.js --bundle --platform=browser --format=esm --outfile=web/dist/bundle.js",
    "dev:web": "esbuild web/src/main.js --bundle --platform=browser --format=esm --outfile=web/dist/bundle.js --watch=silent",
    "preview": "npx --yes serve web -l 5173",
    "dev:local": "node web/dev-server.js",
    "dev": "npm run build:web && wrangler dev",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "iztro": "^2.5.8",
    "lunar-javascript": "^1.7.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
